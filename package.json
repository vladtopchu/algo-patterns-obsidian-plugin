{
  "name": "algo-patterns-trainer",
  "version": "1.0.3",
  "private": true,
  "description": "Algorithm practice and spaced repetition for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
